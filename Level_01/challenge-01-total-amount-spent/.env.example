# Copy to .env and adjust if needed. The suite falls back to the public demo
# values when no .env file is present.
BASE_URL=https://demo.applitools.com

# Public demo credentials
APPLITOOLS_USERNAME=Admin
APPLITOOLS_PASSWORD=Password@123

# Reporting / logging (read by the custom TTA reporter and Winston)
LOG_LEVEL=info
TEST_ENV=DEMO
TEST_AUTHOR=TTA-QA
