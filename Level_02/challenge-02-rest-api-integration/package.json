{
  "name": "challenge-02-rest-api-integration",
  "version": "1.0.0",
  "description": "Automation Challenge 2 (Level 2) - REST API CRUD automation and frontend integration testing against JSONPlaceholder",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test src/tests/api",
    "test:integration": "playwright test src/tests/integration",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "serve:frontend": "node src/frontend/server.js",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.0.0",
    "dotenv": "^17.4.2",
    "typescript": "^5.7.0",
    "winston": "^3.19.0"
  }
}
